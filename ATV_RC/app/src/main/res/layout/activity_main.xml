<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray"
    android:padding="16dp"
    tools:context=".MainActivity"
    tools:ignore="HardCodedText">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ATV DASHBOARD"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Gear Selector (D / R) -->
    <LinearLayout
        android:id="@+id/gearSelector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:background="#1A1A1A"
        android:padding="8dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleText">

        <TextView
            android:id="@+id/gearR"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="R"
            android:textColor="@color/gear_active"
            android:textSize="32sp"
            android:textStyle="bold"
            android:background="@color/status_red" />

        <TextView
            android:id="@+id/gearD"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="D"
            android:textColor="@color/gear_inactive"
            android:textSize="32sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Motor Indicator -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/motorIndicatorCard"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="40dp"
        app:cardBackgroundColor="#333333"
        app:cardCornerRadius="60dp"
        app:cardElevation="12dp"
        app:strokeColor="#444444"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gearSelector">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/motorIconText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENGINE"
                android:textColor="#888888"
                android:textSize="14sp"
                android:textStyle="bold" />
            <View
                android:id="@+id/motorLight"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/status_indicator"
                android:alpha="0.2" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Safety / Status Section -->
    <LinearLayout
        android:id="@+id/safetySection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/motorIndicatorCard">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM STATUS"
            android:textColor="#888888"
            android:textSize="12sp"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/safetyStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOCKED"
            android:textColor="@color/status_red"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Data Display (Footer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/xValueText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="X: 0.00"
            android:textColor="#555555"
            android:textSize="16sp"
            android:fontFamily="sans-serif-monospace" />

        <TextView
            android:id="@+id/yValueText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Y: 2048"
            android:textColor="#555555"
            android:textSize="16sp"
            android:fontFamily="sans-serif-monospace" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>